    .meta {
      color: var(--muted);
      font-size: 0.92rem;
      margin-bottom: 1.75rem;
    }
    .lede {
      font-size: 1.05rem;
      color: var(--accent);
      margin: 0 0 1.5rem;
      max-width: 40rem;
    }
    h2 {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--muted);
      margin: 2rem 0 0.75rem;
      font-weight: 650;
    }
