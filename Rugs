<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ideal Rugs — Shipping update</title>
  <style>
    :root {
      --ink: #111;
      --muted: #666;
      --faint: #999;
      --line: #ddd;
      --bg: #fff;
      --soft: #f7f7f7;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 16px/1.65 Georgia, "Times New Roman", Times, serif;
    }
    main {
      max-width: 42rem;
      margin: 0 auto;
      padding: 3rem 1.25rem 4rem;
    }
    h1 {
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.25;
      margin: 0 0 0.5rem;
      letter-spacing: -0.01em;
    }
    h2 {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 0.7rem;
      font-weight: 650;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 2.25rem 0 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--line);
    }
    .meta {
      color: var(--muted);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 0.85rem;
      margin: 0 0 1.5rem;
    }
    p { margin: 0 0 1rem; }
    strong { font-weight: 700; }
    ul, ol {
      margin: 0 0 1rem;
      padding-left: 1.25rem;
    }
    li { margin: 0.35rem 0; }
    code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.86em;
      background: var(--soft);
      padding: 0.05rem 0.3rem;
      border-radius: 3px;
    }
    a {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    a:hover { color: var(--muted); }
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin: 1.25rem 0 1.5rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    .stat {
      border: 1px solid var(--line);
      padding: 0.85rem 0.9rem;
      background: var(--soft);
    }
    .stat .n {
      font-size: 1.35rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .stat .l {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 0.88rem;
      margin: 0.5rem 0 1rem;
    }
    th, td {
      text-align: left;
      padding: 0.55rem 0.4rem;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    th {
      color: var(--muted);
      font-weight: 550;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    td.num, th.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .old { color: var(--faint); text-decoration: line-through; }
    .new { font-weight: 650; }
    .sku {
      display: block;
      margin-top: 0.15rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
      color: var(--faint);
    }
    .callout {
      border-left: 3px solid #bbb;
      padding: 0.15rem 0 0.15rem 0.9rem;
      margin: 1.25rem 0;
      color: var(--muted);
    }
    footer {
      margin-top: 2.75rem;
      padding-top: 1rem;
      border-top: 1px solid var(--line);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 0.8rem;
      color: var(--faint);
    }
    @media (max-width: 640px) {
      .stats { grid-template-columns: 1fr; }
      .examples-wrap { overflow-x: auto; }
      table.examples { min-width: 36rem; }
    }
  </style>
</head>
