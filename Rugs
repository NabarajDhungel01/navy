      font-weight: 650;
      margin: 0 0 0.5rem;
    }
    p { margin: 0 0 0.85rem; }
    ul, ol {
      margin: 0 0 1rem;
      padding-left: 1.2rem;
    }
    li { margin: 0.3rem 0; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
      gap: 0.75rem;
      margin: 0.75rem 0 1.25rem;
    }
    .stat {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 0.9rem 1rem;
    }
    .stat .n {
      font-size: 1.45rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
    .stat .l {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      font-size: 0.9rem;
